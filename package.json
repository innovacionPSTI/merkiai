{
  "name": "merkiai",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "supabase gen types typescript --local > packages/database/src/types.ts",
    "db:generate:remote": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > packages/database/src/types.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "comment-overrides": "Overrides SOLO para parches de seguridad de transitivas, manteniendo el mismo major (API-compatibles). NUNCA subir de major una dependencia directa aquí (p. ej. zod 3→4 rompe la app); los saltos de major van como HU de migración con pruebas.",
    "overrides": {
      "next": "16.4.3",
      "cookie@<0.7.0": ">=0.7.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "uuid@<11.1.1": ">=11.1.1",
      "brace-expansion@<1.1.21": ">=1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7",
      "js-yaml@>=3.0.0 <3.15.2": ">=3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "@istanbuljs/load-nyc-config>js-yaml": "4.3.2",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.22": ">=8.5.23",
      "browserslist@<=4.28.6": ">=4.28.7",
      "fflate@>=0.4.5 <0.4.9": ">=0.4.9",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "handlebars@>=3.0.0 <=4.7.9": ">=4.7.10",
      "postcss-selector-parser@<6.1.5": ">=6.1.5"
    }
  }
}
