# ─────────────────────────────────────────────────────────────────────────────
# Config de las pruebas E2E (Playwright). Copia a `.env` y ajusta.
# NUNCA apuntes a producción: usa Supabase local o una branch/preview DB.
# ─────────────────────────────────────────────────────────────────────────────

# URLs de las apps bajo prueba (deben estar corriendo: pnpm dev o build+start).
# El storefront resuelve el tenant por HOST → usa un subdominio de prueba.
E2E_WEB_URL=http://tienda-test.localhost:3000
E2E_ADMIN_URL=http://localhost:3001
E2E_CONSOLE_URL=http://localhost:3002

# Tenant de prueba (debe existir tras el seed).
E2E_TENANT_ID=00000000-0000-0000-0000-0000000000e2
E2E_TENANT_HOST=tienda-test.localhost

# Segundo tenant, para probar aislamiento RLS (el A no ve datos del B).
E2E_TENANT_B_ID=00000000-0000-0000-0000-0000000000b2
E2E_TENANT_B_HOST=tienda-b-test.localhost

# Usuario admin de prueba (Stack Auth) — se usa para iniciar sesión una vez.
E2E_ADMIN_EMAIL=e2e-admin@example.test
E2E_ADMIN_PASSWORD=change-me-in-local

# Secreto del endpoint interno de seed (apps/admin INTERNAL_API_SECRET).
E2E_INTERNAL_SECRET=

# Supabase local (service-role) para sembrar/inspeccionar datos directamente.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Si es 1, global-setup intenta sembrar el tenant vía endpoint interno antes de correr.
E2E_SEED=1
