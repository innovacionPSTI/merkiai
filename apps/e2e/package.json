{
  "name": "@merkiai/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Pruebas end-to-end (Playwright) del flujo real: storefront + admin + webhooks → ledger.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "ensure:user": "node scripts/ensure-stack-user.mjs",
    "install:browsers": "playwright install --with-deps chromium",
    "type-check": "tsc --noEmit -p .",
    "smoke": "playwright test --project=storefront --grep @smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
