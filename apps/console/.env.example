# ============================================================
# Merkiai · apps/console (Control plane / operador SaaS)
#   ── .env.local de referencia. Copia a apps/console/.env.local.
# La consola usa su PROPIO proyecto Supabase (BD de PLATAFORMA) y habla con el
# admin (Stack Auth + API interna) para aprovisionar tenants.
# ============================================================

# ─── Supabase · PLANO DE PLATAFORMA (proyecto PROPIO, ≠ tienda) ────────────────
# Registro de tenants/planes/subscripciones. NO es el proyecto de la tienda.
NEXT_PUBLIC_SUPABASE_URL=https://<plataforma>.supabase.co
# Service-role del proyecto de plataforma (la consola es el control plane).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── API interna hacia el ADMIN ───────────────────────────────────────────────
# URL del admin: la consola llama /api/internal/owners y /tenants/seed.
ADMIN_APP_URL=https://admin.merkiai.com
# Secreto server-to-server. ≥ 24 chars. MISMO valor que en web/admin.
INTERNAL_API_SECRET=<secreto-≥24-chars>

# ─── Stack Auth · proyecto CONSOLE (login del operador) ───────────────────────
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=<console-stack-project-id>
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=pck_console_...
HEXCLAVE_SECRET_SERVER_KEY=ssk_console_...

# ─── Stack Auth · proyecto ADMIN (crear Team + invitar dueño del tenant) ──────
# La consola crea el Team del tenant y lo asigna en el proyecto Stack del ADMIN.
NEXT_PUBLIC_ADMIN_HEXCLAVE_PROJECT_ID=<admin-stack-project-id>
NEXT_PUBLIC_ADMIN_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=pck_admin_...
ADMIN_HEXCLAVE_SECRET_SERVER_KEY=ssk_admin_...

# ─── Aprovisionamiento de dominios (HU-174 v3 · abstracción de hosting) ───────
# Nombres GENÉRICOS (no delatan el proveedor) y SIN el prefijo `VERCEL_`, que
# Vercel reserva y no deja usar como env propias. El proveedor gestionado (CDN)
# enruta por Host solo para dominios dados de alta; cada dominio PROPIO se
# registra vía API al activarlo (el wildcard *.merkiai.com cubre los subdominios).
HOSTING_API_TOKEN=          # token con acceso al proyecto del storefront
HOSTING_PROJECT_ID=         # id o NOMBRE del proyecto de la tienda (p. ej. merkiai-web)
HOSTING_TEAM_ID=            # id del team dueño del proyecto (team_...), si aplica
# Destinos DNS que se muestran al comerciante (defaults del CDN gestionado):
HOSTING_A_RECORD=76.76.21.21
HOSTING_CNAME_TARGET=cname.vercel-dns.com

# ─── Vault de secretos · AWS KMS (HU-362 · ADR-007) ──────────────────────────
# ROOT OF TRUST: estas llaves ABREN el vault, por eso viven en env (nunca dentro
# del vault). Usuario IAM `merkiai-<env>-vault` creado por infra/kms-vault (CDK),
# con permisos SOLO sobre la KEK del entorno. El SDK de AWS las lee del entorno.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Alias de la KEK del entorno. Sin esto: InMemoryVault en dev; en producción el
# vault falla-cerrado (no se sirven tenants dedicados).
MERKIAI_VAULT_KEY_ALIAS=alias/merkiai-<env>-tenant-secrets

# ─── Billing SaaS · PayZen/Lyra (HU-440 · ADR-009) ───────────────────────────
# Tienda PayZen PROPIA de Merkiai (cobro de planes). Llaves de TEST en test/develop
# y de PRODUCCIÓN solo en prod. La contraseña firma también las IPN.
PAYZEN_SHOP_ID=
PAYZEN_PASSWORD=            # testpassword_... | prodpassword_...  (secreto)
PAYZEN_PUBLIC_KEY=          # <shopId>:testpublickey_...  (formulario embebido)
# PAYZEN_API_URL=https://api.payzen.lat/api-payment/V4   # default LATAM
# URL de notificación (IPN) a registrar en el Back Office de PayZen:
#   https://<console>/api/billing/payzen/ipn
# Política de cobranza (opcional; default 3 intentos / 7 días de gracia):
# BILLING_DUNNING_MAX_ATTEMPTS=3
# BILLING_DUNNING_GRACE_DAYS=7
# Correos de billing (activación, recibo, impago, suspensión). Sin la key no se envían.
RESEND_API_KEY=
BILLING_EMAIL_FROM="Merkiai <facturacion@merkiai.com>"
