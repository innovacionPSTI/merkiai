# ============================================================
# Merkiai · apps/admin (Panel de tienda)  ── .env.local de referencia
# Copia a apps/admin/.env.local y completa los valores.
# ============================================================

# ─── Supabase · PLANO DE TIENDA (mismo proyecto que web) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# REQUERIDO: el admin acota por RLS (getAdminDb) firmando JWT con is_admin.
# Falla-cerrado si falta. Server-only.
SUPABASE_JWT_SECRET=super-secret-jwt-token-from-supabase
# Service-role: solo islas legítimas del admin (upload a Storage, /api/internal/*).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Multi-tenant ─────────────────────────────────────────────────────────────
# Secreto server-to-server de la API interna. ≥ 24 chars. Igual en web/console.
INTERNAL_API_SECRET=<secreto-≥24-chars>
# (Opcional) URL de la consola, si el admin resuelve datos del control plane.
CONTROL_PLANE_URL=https://console.merkiai.com

# ─── Stack Auth · proyecto ADMIN ──────────────────────────────────────────────
# Proyecto DISTINTO al del sitio web. Aquí viven los Teams de los tenants.
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=<admin-stack-project-id>
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=pck_admin_...
HEXCLAVE_SECRET_SERVER_KEY=ssk_admin_...
# (Opcional) Solo si Stack Auth cambia su URL base de API.
# NEXT_PUBLIC_STACK_API_URL=https://api.stack-auth.com

# ─── URLs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://merkiai.com
# Usada en el link del email de invitación de nuevos usuarios del panel.
NEXT_PUBLIC_ADMIN_URL=https://admin.merkiai.com

# ─── Feature flags ────────────────────────────────────────────────────────────
# HU-218.3 · 'true' habilita el Constructor de páginas (beta, convive con /contenido).
NEXT_PUBLIC_FEATURE_PAGE_BUILDER=false

# ─── Blog · modo borrador ─────────────────────────────────────────────────────
# Debe COINCIDIR con DRAFT_SECRET del web (genera la URL de preview en el cliente).
NEXT_PUBLIC_DRAFT_SECRET=cambia-este-secreto
