# ============================================================
# Merkiai · apps/web (Storefront)  ── .env.local de referencia
# Copia a apps/web/.env.local y completa los valores.
# Las NEXT_PUBLIC_* se inyectan en BUILD → redeploy tras cambiarlas.
# ============================================================

# ─── Supabase · PLANO DE TIENDA (compartido con admin) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy JWT secret de Supabase. Firma el JWT con el claim tenant_id (RLS por
# tenant). REQUERIDO — el storefront falla-cerrado si falta. Server-only.
# Es la "joya de la corona": quien lo tenga puede firmar cualquier tenant.
SUPABASE_JWT_SECRET=super-secret-jwt-token-from-supabase
# Service-role (omite RLS). Solo lo usan islas legítimas sin sesión
# (bootstrap de webhooks skydropx, creación de orden en checkout). Server-only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Tenant por defecto (migración e17/01). No cambiar salvo migración.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── Multi-tenant (resolución host→tenant) ────────────────────────────────────
# URL de la consola (control plane): resuelve host→tenant_id. Si falta, el
# storefront opera en modo single-tenant (tenant por defecto).
CONTROL_PLANE_URL=https://console.merkiai.com
# Secreto server-to-server hacia la API interna. ≥ 24 chars. Igual en web/admin/console.
INTERNAL_API_SECRET=<secreto-≥24-chars>
# Dominio raíz para construir/validar subdominios por host.
NEXT_PUBLIC_ROOT_DOMAIN=merkiai.com
# HU-229 · fail-closed: 'true' → un host sin tenant devuelve 404 (no sirve el
# default). Actívalo SOLO cuando el control plane resuelva bien (multi-tenant).
TENANT_RESOLUTION_STRICT=false

# ─── Stack Auth · proyecto WEB (compradores) ──────────────────────────────────
# Proyecto DISTINTO al del admin (aísla sesiones comprador↔admin).
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=<web-stack-project-id>
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=pck_web_...
HEXCLAVE_SECRET_SERVER_KEY=ssk_web_...

# ─── URLs ─────────────────────────────────────────────────────────────────────
# URL pública del storefront (webhooks, preview del Constructor, links de email).
NEXT_PUBLIC_SITE_URL=https://merkiai.com

# ─── Vista previa (HU-128) ────────────────────────────────────────────────────
# Secreto de firma del token de preview POR-TENANT (HMAC). Debe coincidir con el
# del admin (ambos lo usan: el admin para generar el link, la web para verificar).
# Reemplaza al antiguo DRAFT_SECRET global.
PREVIEW_SIGNING_SECRET=cambia-este-secreto

# ─── Modo mantenimiento ───────────────────────────────────────────────────────
MAINTENANCE_MODE=false

# ============================================================
# NO van por env (se configuran en el admin → Supabase):
#   Pasarelas de pago (Wompi/MercadoPago/Tu Compra/Bold) → payment_config
#   Emails (Resend), WhatsApp, logo, nombre        → store_config
#   Envíos Skydropx (credenciales + tarifa/origen) → shipping_config
# ============================================================
